# ──────────────────────────────────────────────────────────
#  Sector 7 — Backend Environment Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit the real .env to version control.
# ──────────────────────────────────────────────────────────

# --- Server ---
PORT=5000
NODE_PORT=5000
NODE_ENV=production

# --- Database (MongoDB) ---
# Local: mongodb://localhost:27017/sector7
# Docker (replica set): mongodb://mongodb:27017/sector7?replicaSet=rs0
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sector7
MONGODB_URI=mongodb://mongodb:27017/sector7?replicaSet=rs0
MONGODB_DB_NAME=sector7

# --- AI / Groq ---
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=llama3-8b-8192

# --- Authentication (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
ENFORCE_AUTH=false

# --- CORS ---
# Comma-separated list of frontend origins allowed to call the API.
# Example: https://nexus-command.vercel.app,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# --- n8n Automation Webhooks (optional) ---
# Set to an empty string to disable
N8N_WEBHOOK_URL=http://n8n:5678/webhook/replace-me

# --- Google Cloud / Vertex AI (Python service, optional) ---
GCP_PROJECT_ID=replace-with-gcp-project-id
