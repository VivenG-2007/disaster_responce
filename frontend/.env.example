# ──────────────────────────────────────────────────────────
#  Sector 7 — Frontend Environment Template
#  Copy to .env.local and fill in your real values.
#  NEVER commit the real .env.local to version control.
# ──────────────────────────────────────────────────────────

# 🌐 API GATEWAY URL (Node.js backend)
# Local dev: http://localhost:5000
# Production: https://your-backend-service.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# 🌐 Site URL (used for OpenGraph / sitemap metadataBase)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 🛡️ CLERK AUTH (get keys from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# 🔥 FIREBASE (Photo Storage & Sync)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_DATABASE_URL=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# 🧠 GEMINI AI TRIAD KEY
NEXT_PUBLIC_GEMINI_API_KEY="replace-with-your-gemini-key"

